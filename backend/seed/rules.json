   "description": "Fee receipt must match a ledger entry for this institution (TER payment status).",
   "source_reference": "Illustrative — APH: processing fee schedule"},
  {"rule_id": "EOA-ANM-001", "name": "No duplicate files", "group": "ANOMALY", "check": "duplicate_file_hash",
   "params": {}, "severity": "WARNING", "applies_to": ["EOA", "NEW_INSTITUTION", "INTAKE_CHANGE", "NAME_CHANGE"],
   "description": "SHA-256 comparison across all applications.", "source_reference": "Anomaly indicator"},
  {"rule_id": "EOA-ANM-002", "name": "No reused reference numbers", "group": "ANOMALY", "check": "duplicate_reference_number",
   "params": {"fields": ["reference_number"]}, "severity": "WARNING", "applies_to": ["EOA", "NEW_INSTITUTION", "INTAKE_CHANGE", "NAME_CHANGE"],
   "description": "Reference / certificate / transaction numbers should not appear on more than one document.",
   "source_reference": "Anomaly indicator"},
  {"rule_id": "EOA-ANM-003", "name": "Document dates plausible", "group": "ANOMALY", "check": "date_irregularity",
   "params": {}, "severity": "WARNING", "applies_to": ["EOA", "NEW_INSTITUTION", "INTAKE_CHANGE", "NAME_CHANGE"],
   "description": "Issue after expiry, future-dated, or dated before the institution existed.", "source_reference": "Anomaly indicator"},
  {"rule_id": "EOA-ANM-004", "name": "File metadata consistent", "group": "ANOMALY", "check": "metadata_modified_after_creation",
