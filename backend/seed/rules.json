  {"rule_id": "EOA-CON-003", "name": "Programme details match application form", "group": "CONSISTENCY", "check": "programme_details_match_form",
   "params": {}, "severity": "WARNING", "applies_to": ["EOA", "INTAKE_CHANGE"],
